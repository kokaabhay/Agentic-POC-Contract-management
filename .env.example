
# Application
APP_NAME=Vendor Contract Analysis API
LOG_LEVEL=INFO

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING="YOUR_AZURE_STORAGE_CONNECTION_STRING"
AZURE_STORAGE_CONTAINER_NAME=YOUR_EXISTING_CONTAINER_NAME

# Upload settings
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_BATCH=20
ALLOWED_EXTENSIONS=.pdf,.docx

# Blob path prefix
CONTRACT_DOCUMENTS_PREFIX=contract_documents
